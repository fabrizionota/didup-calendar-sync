# Copia in .env (accanto a compose.yml, gitignored) e compila; con Portainer le stesse variabili
# vanno nelle Environment variables dello stack. Una password Argo per ogni alunno/account:
# il nome della variabile è quello indicato da password_env nel suo [[alunni]].
# Alunni con lo stesso account possono usare la stessa variabile.
ARGO_PASSWORD_PRIMO=
ARGO_PASSWORD_SECONDO=

# Notifiche (facoltative)
HA_TOKEN=
TELEGRAM_BOT_TOKEN=

# Allegati su Nextcloud (facoltativo): app password, non quella di login.
# URL e utente qui vincono su [allegati.nextcloud] del config.
NEXTCLOUD_URL=
NEXTCLOUD_USER=
NEXTCLOUD_APP_PASSWORD=
